---
// About page: scrapbook-style portrait + bio on top, experience timeline below.
// Bio text comes from the Framer site; experience lives in src/data/experience.ts.
import { Picture, Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import { links, availability } from '../data/site';
import { experience } from '../data/experience';
import portrait from '../assets/about/tanya-portrait-flowers.jpg';

const facts = [
  {
    icon: 'M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Zm0-9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
    text: 'Ann Arbor, Michigan',
  },
  {
    icon: 'm2 9 10-5 10 5-10 5L2 9Zm4 2.2V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-4.8M22 9v6',
    text: "Master's in Human-Computer Interaction · University of Michigan",
  },
  {
    icon: 'M4 8h16v11H4zM9 8V6a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2',
    text: `${availability.status} · ${availability.detail}`,
  },
];
---

<BaseLayout
  title="About"
  description="Meet Tanya Mirza, a product designer and HCI master's student at the University of Michigan who designs with intention, empathy, and accessibility in mind."
>
  <section class="about-hero relative overflow-hidden" aria-labelledby="about-title">
    <div class="container-page grid items-center gap-14 pt-12 pb-16 md:pt-20 lg:grid-cols-[5fr_7fr] lg:gap-20">
      <!-- Scrapbook polaroid -->
      <div class="mx-auto w-full max-w-sm lg:max-w-none">
        <div class="polaroid group relative">
          <span class="tape tape-left" aria-hidden="true"></span>
          <span class="tape tape-right" aria-hidden="true"></span>
          <figure class="relative rotate-[-3deg] rounded-lg bg-bg p-3 pb-12 shadow-card-hover transition-transform duration-700 ease-out group-hover:rotate-0 group-hover:-translate-y-1.5 motion-reduce:transition-none">
            <Picture
              src={portrait}
              alt="Tanya sitting in a field of lilac phlox flowers, smiling over her shoulder in a white dress and a maize-and-blue Michigan graduation stole."
              formats={['avif']}
              fallbackFormat="webp"
              widths={[360, 540, 720, 960]}
              sizes="(min-width: 1024px) 450px, (min-width: 640px) 384px, 90vw"
              loading="eager"
              fetchpriority="high"
              class="h-auto w-full rounded-md"
            />
            <figcaption class="absolute inset-x-0 bottom-3 text-center font-display text-sm font-medium text-sage-dark">
              Go Blue!{' '}
              <span aria-hidden="true" class="text-sage">
                ✦
              </span>
            </figcaption>
          </figure>
          <!-- Hand-drawn star doodles -->
          <svg class="doodle doodle-1" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2c.8 6 3.9 9.1 10 10-6.1.9-9.2 4-10 10-.8-6-3.9-9.1-10-10 6.1-.9 9.2-4 10-10Z"></path>
          </svg>
          <svg class="doodle doodle-2" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m12 2 2.9 6.6 7.1.6-5.4 4.7 1.6 7L12 17.3 5.8 21l1.6-7L2 9.2l7.1-.6Z"></path>
          </svg>
          <svg class="doodle doodle-3" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2c.8 6 3.9 9.1 10 10-6.1.9-9.2 4-10 10-.8-6-3.9-9.1-10-10 6.1-.9 9.2-4 10-10Z"></path>
          </svg>
        </div>

        <ul role="list" class="mt-12 space-y-3">
          {facts.map((f) => (
            <li class="flex items-start gap-3 text-sm text-muted">
              <svg
                aria-hidden="true"
                class="mt-0.5 size-5 shrink-0 text-sage"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={f.icon} />
              </svg>
              {f.text}
            </li>
          ))}
        </ul>
      </div>

      <!-- Bio -->
      <div>
        <p class="eyebrow">
          <span aria-hidden="true" class="mr-1.5 text-sage">
            ✦
          </span>
          About me
        </p>
        <h1 id="about-title" class="mt-4 text-h1 font-semibold text-ink">
          I’m drawn to the crossroads of design, technology, and
          <span class="highlight relative inline-block text-sage-dark sm:whitespace-nowrap">
            the way people think.
            <svg
              class="squiggle"
              viewBox="0 0 300 16"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path d="M3 11c30-8 50 6 80-1s45-8 75 0 50 7 80-1 40-6 59 1"></path>
            </svg>
          </span>
        </h1>

        <div class="mt-8 space-y-5 text-lg text-muted">
          <p>
            In a world where computing and engineering drive rapid change, UX design plays a
            critical role in elevating technology beyond its function to create meaningful
            experiences that are <strong class="text-ink">intuitive, intentional, and human</strong>
            . This is where my interests naturally come together, allowing me to design experiences
            grounded in clarity, usability, and accessibility.
          </p>
          <p>
            As a Product Designer, I approach my work with{' '}
            <strong class="text-ink">intention, empathy, and structure</strong>, translating
            ambiguous problems into clear, intuitive experiences through research-driven decision
            making and strong visual systems. Accessibility and inclusivity are central to my
            process, inspired by my <strong class="text-ink">Bengali heritage</strong> and its
            emphasis on storytelling: coming from a culture that fought to preserve its language,
            art, and voice, I’ve learned that even the smallest details come together to tell a
            larger story.
          </p>
          <p>
            Outside of design work, creativity is a constant in my life. I believe that what may
            seem “small” can often carry the most meaning, and I aim to create experiences where{' '}
            <strong class="text-ink">thoughtful details work cohesively</strong> to form systems
            that feel seamless and human.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section aria-labelledby="experience-title" class="container-page pb-8">
    <div class="border-t border-line pt-14 lg:grid lg:grid-cols-[5fr_7fr] lg:gap-20">
      <Reveal>
        <h2 id="experience-title" class="text-h2 text-sage-dark">
          Experience
        </h2>
        <a
          href={links.resume}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-flex min-h-11 items-center gap-1 font-display text-sm font-medium text-muted hover:text-sage"
        >
          Resume <span aria-hidden="true">↗</span>
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </Reveal>

      <ol role="list" class="mt-6 divide-y divide-line lg:mt-0">
        {experience.map((org, i) => (
          <Reveal as="li" delay={i * 120} class="flex gap-4 py-6 first:pt-0 sm:gap-5">
            <Image
              src={org.logo}
              alt=""
              widths={[56, 112]}
              sizes="56px"
              class="size-14 shrink-0 rounded-full border border-line object-cover"
            />
            <div class="min-w-0 flex-1">
              <h3 class="font-display text-lg leading-snug font-semibold text-ink">{org.name}</h3>
              <ul
                role="list"
                class:list={['mt-2 space-y-2', org.roles.length > 1 && 'roles-timeline']}
              >
                {org.roles.map((r) => (
                  <li class="role relative flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
                    <span class="text-ink">{r.title}</span>
                    <span class="text-sm text-muted tabular-nums">{r.dates}</span>
                  </li>
                ))}
              </ul>
            </div>
          </Reveal>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  /* Faint sprinkle of dots behind the top section (like scrapbook paper) */
  .about-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(
      color-mix(in srgb, var(--color-sage) 22%, transparent) 1.2px,
      transparent 1.4px
    );
    background-size: 22px 22px;
    mask: radial-gradient(70% 80% at 25% 40%, #000 10%, transparent 75%);
  }

  /* Washi tape holding the polaroid */
  .tape {
    position: absolute;
    top: -14px;
    z-index: 1;
    width: 96px;
    height: 28px;
    background: color-mix(in srgb, var(--color-sage) 35%, transparent);
    border-left: 2px dashed color-mix(in srgb, var(--color-bg) 60%, transparent);
    border-right: 2px dashed color-mix(in srgb, var(--color-bg) 60%, transparent);
  }
  .tape-left {
    left: 6%;
    rotate: -18deg;
  }
  .tape-right {
    right: 4%;
    rotate: 14deg;
  }

  /* Star doodles */
  .doodle {
    position: absolute;
    fill: var(--color-sage);
  }
  .doodle-1 {
    top: 10%;
    right: -26px;
    width: 30px;
  }
  .doodle-2 {
    bottom: 22%;
    left: -24px;
    width: 22px;
    fill: none;
    stroke: var(--color-sage-dark);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .doodle-3 {
    bottom: -14px;
    right: 14%;
    width: 18px;
  }

  /* Hand-drawn underline under the highlighted phrase */
  .squiggle {
    position: absolute;
    left: 0;
    bottom: -0.32em;
    width: 100%;
    height: 0.42em;
    overflow: visible;
  }
  .squiggle path {
    fill: none;
    stroke: var(--color-sage);
    stroke-width: 3.5;
    stroke-linecap: round;
  }

  /* Roles at the same organization read as a little timeline of stars */
  .roles-timeline {
    position: relative;
    padding-left: 1.25rem;
  }
  .roles-timeline::before {
    content: '';
    position: absolute;
    top: 0.55em;
    bottom: 0.55em;
    left: 0.3rem;
    width: 1px;
    background: var(--color-line);
  }
  .roles-timeline .role::before {
    content: '✦';
    position: absolute;
    left: -1.25rem;
    top: 0.1em;
    width: 0.85rem;
    text-align: center;
    font-size: 0.75rem;
    color: var(--color-sage);
    background: var(--color-bg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .polaroid figure {
      animation: polaroid-in 1100ms var(--ease-spring) 200ms both;
    }
    .doodle {
      animation: twinkle 3.2s ease-in-out infinite;
    }
    .doodle-2 {
      animation-delay: 1.1s;
    }
    .doodle-3 {
      animation-delay: 2s;
    }
    .squiggle path {
      stroke-dasharray: 360;
      stroke-dashoffset: 360;
      animation: draw 1400ms var(--ease-out) 900ms forwards;
    }
    .polaroid:hover .doodle {
      animation-duration: 1.2s;
    }
  }

  @keyframes polaroid-in {
    from {
      opacity: 0;
      transform: translateY(24px) rotate(-10deg);
    }
  }
  @keyframes twinkle {
    50% {
      transform: scale(0.7) rotate(20deg);
      opacity: 0.55;
    }
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
