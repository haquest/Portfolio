---
// Shared layout for every case study: header, hero, overview (meta + TL;DR + stats),
// sticky table of contents, the MDX body, and a "Next project" card.
import { Picture } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import CaseStudyToc from '../components/case-study/CaseStudyToc.astro';
import MetaGrid from '../components/case-study/MetaGrid.astro';
import NextProjectCard from '../components/case-study/NextProjectCard.astro';
import ReadingProgress from '../components/case-study/ReadingProgress.astro';
import Lightbox from '../components/case-study/Lightbox.astro';
import StatRow from '../components/case-study/StatRow.astro';
import Reveal from '../components/Reveal.astro';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
  toc: { id: string; label: string }[];
  next?: Project;
  ogImage: string;
}

const { project, toc, next, ogImage } = Astro.props;
const d = project.data;
const items = [{ id: 'overview', label: 'Overview' }, ...toc];
---

<BaseLayout
  title={d.title}
  description={d.description}
  image={ogImage}
  imageAlt={d.thumbnailAlt}
  type="article"
>
  <ReadingProgress />
  <Lightbox />

  <div class="container-page pt-6 md:pt-10">
    <a
      href="/#projects"
      class="group -ml-1 inline-flex min-h-11 items-center gap-2 px-1 font-display text-sm font-medium text-sage-dark hover:text-sage"
    >
      <span
        aria-hidden="true"
        class="transition-transform duration-200 group-hover:-translate-x-1 motion-reduce:transform-none"
      >
        ←
      </span>
      Back to work
    </a>

    <header class="mt-6 max-w-3xl">
      {d.eyebrow && (
        <p class="eyebrow">
          <span aria-hidden="true" class="mr-1.5 text-sage">
            ✦
          </span>
          {d.eyebrow}
        </p>
      )}
      <h1 class="mt-4 text-h1 font-bold text-sage-dark">{d.title}</h1>
      {d.subtitle && <p class="mt-4 text-lg text-muted">{d.subtitle}</p>}
    </header>

    <figure class="mt-10">
      <Picture
        src={d.hero ?? d.thumbnail}
        alt={d.hero ? (d.heroAlt ?? '') : d.thumbnailAlt}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[480, 800, 1200, 1600, 2200]}
        sizes="(min-width: 1152px) 1088px, calc(100vw - 40px)"
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full rounded-card border border-line/70"
      />
      {d.heroCaption && <figcaption class="mt-3 text-sm text-muted">{d.heroCaption}</figcaption>}
    </figure>

    <!-- The mobile TOC bar sticks for as long as this wrapper is on screen. -->
    <div class="mt-10 md:mt-14">
      <CaseStudyToc items={items} variant="mobile" />

      <div class="lg:grid lg:grid-cols-[200px_minmax(0,1fr)] lg:gap-16">
        <aside class="hidden lg:block">
          <CaseStudyToc items={items} variant="desktop" />
        </aside>

        <article class="cs-article min-w-0">
          <section id="overview" class="cs-section cs-overview" aria-labelledby="overview-title">
            <h2 id="overview-title" class="sr-only">
              Overview
            </h2>
            <MetaGrid
              role={d.role}
              timeline={d.timeline}
              team={d.team}
              tools={d.tools}
              methods={d.methods}
            />
            {d.tldr && (
              <div class="mt-8 rounded-card bg-sage-50 px-6 py-5">
                <p class="eyebrow">
                  <span aria-hidden="true" class="mr-1.5 text-sage">
                    ✦
                  </span>
                  TL;DR
                </p>
                <p class="mt-2 text-lg text-ink">{d.tldr}</p>
              </div>
            )}
            {d.stats && <StatRow stats={d.stats} label="Key numbers" />}
          </section>

          <slot />
        </article>
      </div>
    </div>

    {next && (
      <Reveal>
        <NextProjectCard project={next} />
      </Reveal>
    )}
  </div>
</BaseLayout>

<script>
  // Scroll-spy for the table of contents + the reading progress line.
  const sections = [...document.querySelectorAll<HTMLElement>('.cs-section[id]')];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const currentLabel = document.querySelector<HTMLElement>('[data-toc-current]');
  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
  const mobileToc = document.querySelector<HTMLDetailsElement>('.cs-toc-mobile');
  let active = '';
  let ticking = false;

  function update() {
    ticking = false;
    // The active section is the last one whose top has passed ~35% of the screen.
    const line = window.innerHeight * 0.35;
    let id = sections[0]?.id ?? '';
    for (const s of sections) if (s.getBoundingClientRect().top <= line) id = s.id;
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
      id = sections.at(-1)?.id ?? id;
    }
    if (id !== active) {
      active = id;
      for (const a of links) {
        if (a.dataset.tocLink === id) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
      const label = links.find((a) => a.dataset.tocLink === id)?.textContent?.trim();
      if (currentLabel && label) currentLabel.textContent = label;
    }
    if (progress) {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.transform = `scaleX(${max > 0 ? Math.min(window.scrollY / max, 1) : 0})`;
    }
  }

  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  update();

  // Headline numbers count up once when they scroll into view.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const counters = document.querySelectorAll<HTMLElement>('[data-count]');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          io.unobserve(entry.target);
          const el = entry.target as HTMLElement;
          const target = el.dataset.count!;
          const end = parseFloat(target.replace(/,/g, ''));
          const decimals = (target.split('.')[1] ?? '').length;
          const start = performance.now();
          const tick = (now: number) => {
            const t = Math.min((now - start) / 1800, 1);
            const eased = 1 - Math.pow(1 - t, 3);
            el.textContent = t < 1 ? (end * eased).toFixed(decimals) : target;
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      },
      { threshold: 0.6 },
    );
    counters.forEach((c) => io.observe(c));
  }

  // Close the phone/tablet dropdown after choosing a section.
  mobileToc?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) mobileToc.open = false;
  });
</script>
