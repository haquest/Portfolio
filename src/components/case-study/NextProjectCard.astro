---
// "Next project" card at the end of a case study (lifts on hover like the home cards).
import { Image } from 'astro:assets';
import { projectUrl, type Project } from '../../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, thumbnail, thumbnailAlt } = project.data;
---

<section aria-labelledby="next-project-title" class="mt-20">
  <p class="eyebrow">
    <span aria-hidden="true" class="mr-1.5 text-sage">
      ★
    </span>
    Next project
  </p>
  <article class="group relative mt-4 grid overflow-hidden rounded-card border border-line/70 bg-bg shadow-card transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:shadow-card-hover has-[a:focus-visible]:-translate-y-1 has-[a:focus-visible]:shadow-card-hover has-[a:focus-visible]:outline-3 has-[a:focus-visible]:outline-offset-4 has-[a:focus-visible]:outline-sage motion-reduce:hover:translate-y-0 md:grid-cols-[2fr_3fr]">
    <div class="relative aspect-[16/10] overflow-hidden bg-surface md:aspect-auto md:min-h-64">
      <Image
        src={thumbnail}
        alt={thumbnailAlt}
        widths={[400, 640, 960]}
        sizes="(min-width: 768px) 40vw, 100vw"
        class="size-full object-cover md:absolute md:inset-0 transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:group-hover:scale-100"
      />
    </div>
    <div class="flex flex-col justify-center gap-3 p-6 md:p-10">
      <h2 id="next-project-title" class="text-h2">
        <a
          href={projectUrl(project)}
          class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none"
        >
          {title}
        </a>
      </h2>
      <p class="text-muted">{description}</p>
      <p
        class="mt-2 inline-flex items-center gap-1.5 font-display text-sm font-medium text-sage"
        aria-hidden="true"
      >
        Read case study
        <span class="transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transform-none">
          →
        </span>
      </p>
    </div>
  </article>
</section>
