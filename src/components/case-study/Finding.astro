---
// One research finding with a short label: <Finding n="F1" kicker="Finding one" title="…">…</Finding>
interface Props {
  n: string;
  title: string;
  kicker?: string;
}

const { n, title, kicker } = Astro.props;
---

<div class="cs-finding mt-12 first:mt-6">
  <div class="flex items-center gap-3">
    <span class="inline-flex size-11 items-center justify-center rounded-full bg-sage font-display text-sm font-semibold text-bg">
      {n}
    </span>
    {kicker && <span class="eyebrow">{kicker}</span>}
  </div>
  <h3 class="mt-4 text-h3">{title}</h3>
  <slot />
</div>
