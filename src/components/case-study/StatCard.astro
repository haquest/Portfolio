---
// One headline number. Use inside <StatRow>, or on its own inside a <ul role="list">.
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<li class="flex flex-col gap-1 rounded-card bg-surface px-5 py-5">
  <span class="font-display text-h2 leading-none font-bold text-sage-dark">{value}</span>
  <span class="text-sm text-muted">{label}</span>
</li>
