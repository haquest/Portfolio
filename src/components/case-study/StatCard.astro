---
// One headline number. Use inside <StatRow>, or on its own inside a <ul role="list">.
// The number counts up when it scrolls into view (skipped for reduced motion / no JS).
interface Props {
  value: string;
  label: string;
  /** Position in its row, used to stagger the entrance. */
  i?: number;
}

const { value, label, i = 0 } = Astro.props;
// Split "43.5%" into prefix "", number "43.5", suffix "%" so only the number animates.
const m = value.match(/^([^\d]*)([\d,.]+)(.*)$/);
---

<li class="cs-card flex flex-col gap-1 rounded-card bg-surface px-5 py-5" style={`--i: ${i}`}>
  <span class="font-display text-h2 leading-none font-bold text-sage-dark">
    <span class="sr-only">{value}</span>
    <span aria-hidden="true">
      {m ? m[1] : ''}
      <span data-count={m ? m[2] : undefined}>{m ? m[2] : value}</span>
      {m ? m[3] : ''}
    </span>
  </span>
  <span class="text-sm text-muted">{label}</span>
</li>
