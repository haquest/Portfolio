---
// Card-sort results drawn in the portfolio style: each participant's groups as columns of
// "cards", with a toggle between participants (same tabs as <Compare>).
//   <CardSort id="sort" sorts={[{ label: 'Participant 1', groups: [{ title, cards, highlight? }] }]}
//     confusing={['The Toxic Trio']} />
// `highlight` marks a group worth noticing (e.g. the "safety hub"); cards listed in `confusing`
// get a "?" marker and a legend. Without JavaScript every participant is shown in turn.
interface Group {
  title: string;
  cards: string[];
  highlight?: boolean;
}

interface Props {
  id: string;
  sorts: { label: string; groups: Group[] }[];
  confusing?: string[];
  /** Small label on highlighted groups. */
  highlightLabel?: string;
}

const { id, sorts, confusing = [], highlightLabel = 'Safety hub' } = Astro.props;
const isConfusing = (card: string) =>
  confusing.some((c) => card.toLowerCase().includes(c.toLowerCase()));
---

<div class="cs-cardsort cs-compare cs-wide my-10" data-tabs>
  <div
    role="tablist"
    aria-label="Card sort participants"
    class="hidden w-fit gap-1 rounded-pill bg-surface p-1"
  >
    {sorts.map((s, i) => (
      <button
        type="button"
        role="tab"
        id={`${id}-tab-${i}`}
        aria-controls={`${id}-panel-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class="min-h-11 rounded-pill px-5 font-display text-sm font-medium text-sage-dark transition-colors aria-selected:bg-sage aria-selected:text-bg aria-selected:shadow-card"
      >
        {s.label}
      </button>
    ))}
  </div>

  {sorts.map((s, i) => (
    <section
      role="tabpanel"
      id={`${id}-panel-${i}`}
      aria-labelledby={`${id}-tab-${i}`}
      tabindex="0"
      class="cs-compare-panel"
    >
      <p class="cs-compare-fallback eyebrow mt-6">{s.label}</p>
      <ul role="list" class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {s.groups.map((g) => (
          <li
            class:list={[
              'rounded-card p-5',
              g.highlight ? 'bg-sage-50 ring-2 ring-sage' : 'bg-surface',
            ]}
          >
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h4 class="font-display font-semibold text-sage-dark">“{g.title}”</h4>
              <span class="text-xs text-muted">
                {g.cards.length} {g.cards.length === 1 ? 'card' : 'cards'}
              </span>
            </div>
            {g.highlight && (
              <p class="mt-1 font-display text-xs font-medium tracking-wider text-sage-dark uppercase">
                <span aria-hidden="true">✦ </span>
                {highlightLabel}
              </p>
            )}
            <ul role="list" class="mt-3 flex flex-wrap gap-1.5">
              {g.cards.map((c) => (
                <li class="inline-flex items-center gap-1 rounded-lg border border-line bg-bg px-2.5 py-1 text-sm text-ink">
                  {c}
                  {isConfusing(c) && (
                    <>
                      <span
                        aria-hidden="true"
                        class="ml-0.5 inline-flex size-4 items-center justify-center rounded-full bg-sage font-display text-xs font-semibold text-bg"
                      >
                        ?
                      </span>
                      <span class="sr-only">(confusing label)</span>
                    </>
                  )}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>
  ))}

  {confusing.length > 0 && (
    <p class="mt-4 flex items-center gap-2 text-sm text-muted">
      <span
        aria-hidden="true"
        class="inline-flex size-4 items-center justify-center rounded-full bg-sage font-display text-xs font-semibold text-bg"
      >
        ?
      </span>
      Labels participants found confusing
    </p>
  )}
</div>

<script>
  import '../../lib/tabs';
</script>
