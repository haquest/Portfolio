---
import ProjectCard from './ProjectCard.astro';
import Reveal from './Reveal.astro';
import { getProjects } from '../lib/projects';

const projects = await getProjects();
---

<section id="projects" aria-labelledby="projects-title" class="container-page pt-12 pb-8 md:pt-16">
  <Reveal>
    <p class="label-mono text-sage">Selected work</p>
    <h2 id="projects-title" class="mt-3 text-h1">
      Projects
    </h2>
  </Reveal>

  <ul class="mt-10 grid gap-6 md:grid-cols-2 md:gap-8" role="list">
    {projects.map((project, i) => (
      <Reveal as="li" delay={(i % 2) * 100}>
        <ProjectCard project={project} eager={i === 0} />
      </Reveal>
    ))}
  </ul>
</section>
