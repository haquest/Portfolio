---
import ProjectCard from './ProjectCard.astro';
import Reveal from './Reveal.astro';
import { getProjects } from '../lib/projects';

const projects = await getProjects();
---

<section
  id="projects"
  aria-labelledby="projects-title"
  class="container-page scroll-mt-16 pt-16 pb-8 md:pt-20"
>
  <Reveal class="flex items-center gap-4">
    <h2 id="projects-title" class="eyebrow">
      <span aria-hidden="true" class="mr-1.5 text-sage">
        ✦
      </span>
      Selected work
    </h2>
    <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
  </Reveal>

  <ul class="mt-8 grid gap-6 md:grid-cols-2 md:gap-8" role="list">
    {projects.map((project, i) => (
      <Reveal as="li" delay={(i % 2) * 100}>
        <ProjectCard project={project} eager={i === 0} />
      </Reveal>
    ))}
  </ul>
</section>
