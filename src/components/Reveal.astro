---
// Wrap content to fade it up as it scrolls into view.
// Without JavaScript, or with reduced motion on, content is simply shown.
import type { HTMLTag } from 'astro/types';

interface Props {
  as?: HTMLTag;
  /** Stagger delay in ms, e.g. for cards in a grid. */
  delay?: number;
  class?: string;
}

const { as: Tag = 'div', delay = 0, class: className } = Astro.props;
---

<Tag data-reveal class={className} style={delay ? `--reveal-delay: ${delay}ms` : undefined}>
  <slot />
</Tag>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    items.forEach((el) => io.observe(el));
  } else {
    items.forEach((el) => el.classList.add('is-visible'));
  }
</script>
