---
// Doodle-star cursor: a hand-drawn light-sage star with a thin sage-dark edge (so it shows on
// white and on the green buttons), slightly uneven points and soft rounded corners,
// that leaves a trail of little sparkles as it moves. Over clickable things it grows and
// wiggles; a click spins it and pops a ring of sparkles. Only runs for mouse/trackpad users
// who haven't asked for reduced motion; everyone else gets the static star from global.css.
---

<div id="star-cursor" aria-hidden="true">
  <div class="star-cursor__shape">
    <svg viewBox="0 0 32 32" width="24" height="24">
      <path d="M16 3.5c1.1 3.9 2.3 6.9 3.7 8.9 3.3.2 6.5.5 8.9 1.2-2.4 2.4-5 4.4-7.2 6 .8 3.4 1.4 6.4 1.6 9-2.4-1.6-4.7-3.3-6.8-4.7-2.4 1.6-4.9 3.3-7.4 4.5.7-2.8 1.5-5.8 2.2-8.8-2.4-1.8-4.9-3.8-7.4-6.2 3-.5 6-.9 9-1.2 1.2-2.8 2.2-5.8 3.4-8.7Z"></path>
    </svg>
  </div>
</div>

<style>
  #star-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    width: 24px;
    height: 24px;
    margin: -12px 0 0 -12px; /* centre the star on the pointer */
    pointer-events: none;
    opacity: 0;
    transition: opacity 150ms;
    will-change: transform;
  }
  :global(html.star-cursor) #star-cursor.is-visible {
    opacity: 1;
  }
  .star-cursor__shape {
    width: 100%;
    height: 100%;
    transition: transform 300ms var(--ease-spring);
  }
  svg {
    overflow: visible;
  }
  path {
    --sage-light: color-mix(in srgb, var(--color-sage) 45%, var(--color-bg));
    fill: var(--sage-light);
    stroke: var(--color-sage-dark);
    stroke-width: 1.8;
    stroke-linejoin: round;
    transition:
      fill 200ms,
      stroke 200ms;
  }
  /* Over anything clickable: grow and wiggle */
  #star-cursor.is-hover .star-cursor__shape {
    transform: scale(1.25);
  }
  #star-cursor.is-hover svg {
    animation: star-wiggle 900ms ease-in-out infinite;
  }
  /* Paler over buttons and links */
  #star-cursor.is-hover path {
    fill: var(--color-sage-50);
    stroke: var(--color-sage-dark);
  }
  /* On click: one spin */
  #star-cursor.is-click svg {
    animation: star-spin 550ms var(--ease-out);
  }
  /* Trail sparkles (created by the script below) */
  :global(.star-trail) {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9998;
    pointer-events: none;
    clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
    opacity: 0;
  }
  @keyframes star-wiggle {
    25% {
      transform: rotate(-12deg);
    }
    75% {
      transform: rotate(12deg);
    }
  }
</style>

<script>
  const fine = window.matchMedia('(pointer: fine)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const star = document.getElementById('star-cursor');
  const svg = star?.querySelector('svg');
  const clickable = 'a, button, summary, label, [role="button"], [role="tab"], .cs-media';

  if (star && svg && fine.matches && !reduce.matches) {
    document.documentElement.classList.add('star-cursor');

    // A small pool of sparkles, reused round-robin so the page never fills up with nodes.
    const colors = [
      'var(--color-sage)',
      'color-mix(in srgb, var(--color-sage) 45%, var(--color-bg))',
    ];
    const pool = Array.from({ length: 16 }, () => {
      const s = document.createElement('span');
      s.className = 'star-trail';
      s.setAttribute('aria-hidden', 'true');
      document.body.append(s);
      return s;
    });
    let next = 0;
    let last = { x: 0, y: 0, t: 0 };

    // Each sparkle appears near the pointer, drifts down a little, spins and fades.
    const sparkle = (x: number, y: number, dx: number, dy: number, life = 900) => {
      const s = pool[next++ % pool.length];
      const size = 8 + Math.random() * 7;
      s.style.width = s.style.height = `${size}px`;
      s.style.background = colors[Math.floor(Math.random() * colors.length)];
      const from = `translate(${x - size / 2}px, ${y - size / 2}px)`;
      const to = `translate(${x - size / 2 + dx}px, ${y - size / 2 + dy}px)`;
      s.animate(
        [
          { transform: `${from} scale(1) rotate(0deg)`, opacity: 0.95 },
          { transform: `${to} scale(0.2) rotate(140deg)`, opacity: 0 },
        ],
        { duration: life, easing: 'ease-in' },
      );
    };

    window.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse') return;
        const { clientX: x, clientY: y } = e;
        star.style.transform = `translate3d(${x}px, ${y}px, 0)`;
        star.classList.add('is-visible');
        star.classList.toggle('is-hover', !!(e.target as Element).closest?.(clickable));
        // Drop a sparkle every ~18px of movement (and not more than every 35ms)
        if (Math.hypot(x - last.x, y - last.y) > 18 && e.timeStamp - last.t > 35) {
          const jitter = () => (Math.random() - 0.5) * 10;
          sparkle(x + jitter(), y + jitter(), jitter(), 10 + Math.random() * 12);
          last = { x, y, t: e.timeStamp };
        }
      },
      { passive: true },
    );
    document.documentElement.addEventListener('pointerleave', () =>
      star.classList.remove('is-visible'),
    );
    window.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      star.classList.remove('is-click');
      void star.offsetWidth; // restart the spin if clicking quickly
      star.classList.add('is-click');
      // A little ring of sparkles bursting outwards
      for (let i = 0; i < 6; i++) {
        const a = (i / 6) * Math.PI * 2;
        sparkle(e.clientX, e.clientY, Math.cos(a) * 30, Math.sin(a) * 30, 700);
      }
    });
    svg.addEventListener('animationend', (e) => {
      if ((e as AnimationEvent).animationName.includes('spin')) star.classList.remove('is-click');
    });
  }
</script>
