---
// Sparkle cursor: a sage four-point sparkle with an ink outline (so it shows on white and
// doesn't echo the logo's five-point ★), plus a tiny companion sparkle that twinkles.
// Over clickable things it turns a quarter, grows and the companion swings round; a click
// spins it and sends out a ring. Only runs for mouse/trackpad users who haven't asked for
// reduced motion; everyone else gets the static sparkle from global.css.
---

<div id="star-cursor" aria-hidden="true">
  <div class="star-cursor__shape">
    <svg viewBox="0 0 32 32" width="32" height="32">
      <path
        class="main"
        d="M16 4c1 6.4 5.6 11 12 12-6.4 1-11 5.6-12 12-1-6.4-5.6-11-12-12 6.4-1 11-5.6 12-12Z"
      ></path>
      <path
        class="mini"
        d="M27 1.5c.4 2.3 1.2 3.1 3.5 3.5-2.3.4-3.1 1.2-3.5 3.5-.4-2.3-1.2-3.1-3.5-3.5 2.3-.4 3.1-1.2 3.5-3.5Z"
      ></path>
    </svg>
  </div>
  <span class="star-cursor__ring"></span>
</div>

<style>
  #star-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    width: 32px;
    height: 32px;
    margin: -16px 0 0 -16px; /* centre the sparkle on the pointer */
    pointer-events: none;
    opacity: 0;
    transition: opacity 150ms;
    will-change: transform;
  }
  :global(html.star-cursor) #star-cursor.is-visible {
    opacity: 1;
  }
  .star-cursor__shape {
    width: 100%;
    height: 100%;
    transition: transform 300ms var(--ease-spring);
  }
  svg {
    overflow: visible;
  }
  .main {
    fill: var(--color-sage);
    stroke: var(--color-ink);
    stroke-width: 1.6;
    stroke-linejoin: round;
    transition: fill 200ms;
  }
  .mini {
    fill: var(--color-ink);
    transform-origin: 16px 16px;
    transition: transform 400ms var(--ease-spring);
    animation: mini-twinkle 1.6s ease-in-out infinite;
  }
  /* Over anything clickable: quarter turn, grow, light fill; the mini sparkle swings round */
  #star-cursor.is-hover .star-cursor__shape {
    transform: rotate(45deg) scale(1.25);
  }
  #star-cursor.is-hover .main {
    fill: var(--color-sage-50);
  }
  #star-cursor.is-hover .mini {
    transform: rotate(180deg);
  }
  /* On click: one spin plus a ring that ripples out */
  #star-cursor.is-click .star-cursor__shape {
    animation: star-spin 550ms var(--ease-out);
  }
  .star-cursor__ring {
    position: absolute;
    inset: 4px;
    border: 1.5px solid var(--color-sage-dark);
    border-radius: 50%;
    opacity: 0;
  }
  #star-cursor.is-click .star-cursor__ring {
    animation: star-ring 550ms var(--ease-out);
  }
  @keyframes mini-twinkle {
    50% {
      opacity: 0.25;
    }
  }
  @keyframes star-ring {
    from {
      opacity: 0.8;
      transform: scale(0.4);
    }
    to {
      opacity: 0;
      transform: scale(1.8);
    }
  }
</style>

<script>
  const fine = window.matchMedia('(pointer: fine)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const star = document.getElementById('star-cursor');
  const shape = star?.firstElementChild;
  const clickable = 'a, button, summary, label, [role="button"], [role="tab"], .cs-media';

  if (star && shape && fine.matches && !reduce.matches) {
    document.documentElement.classList.add('star-cursor');

    window.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse') return;
        star.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
        star.classList.add('is-visible');
        star.classList.toggle('is-hover', !!(e.target as Element).closest?.(clickable));
      },
      { passive: true },
    );
    document.documentElement.addEventListener('pointerleave', () =>
      star.classList.remove('is-visible'),
    );
    window.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      star.classList.remove('is-click');
      void star.offsetWidth; // restart the spin if clicking quickly
      star.classList.add('is-click');
    });
    shape.addEventListener('animationend', (e) => {
      if ((e as AnimationEvent).animationName.includes('spin')) star.classList.remove('is-click');
    });
  }
</script>
